// =============================================================================
// TEMPLATE DE CONFIGURATION — arduino_secrets.h
// =============================================================================
// UTILISATION :
//   1. Copier ce fichier dans le dossier du module concerné
//   2. Le renommer en "arduino_secrets.h"
//   3. Remplir les valeurs
//   4. Ne JAMAIS committer arduino_secrets.h (il est dans .gitignore)
//
// MODULES CONCERNÉS :
//   - Heltec_Direct_WiFi_Sensor  → WiFi + Adafruit IO
//   - LoRa_Receiver_HeltecV3     → WiFi + Adafruit IO
//   - LoRa_Receiver_M5Core       → WiFi + Adafruit IO
//   - LoRa_Sender_MKR-WAN-1310   → LoRaWAN OTAA (The Things Network)
// =============================================================================

#pragma once

// -----------------------------------------------------------------------------
// SECTION 1 — WiFi
// Utilisé par : Heltec_Direct_WiFi_Sensor, LoRa_Receiver_HeltecV3, LoRa_Receiver_M5Core
// -----------------------------------------------------------------------------
#define SECRET_WIFI_SSID     "NOM_DU_RESEAU_WIFI"
#define SECRET_WIFI_PASSWORD "MOT_DE_PASSE_WIFI"

// -----------------------------------------------------------------------------
// SECTION 2 — Adafruit IO (MQTT)
// Utilisé par : Heltec_Direct_WiFi_Sensor, LoRa_Receiver_HeltecV3, LoRa_Receiver_M5Core
// Obtenir les credentials : https://io.adafruit.com → Mon compte → clé AIO
// -----------------------------------------------------------------------------
#define SECRET_AIO_USERNAME  "votre_username_adafruit"
#define SECRET_AIO_KEY       "aio_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// -----------------------------------------------------------------------------
// SECTION 3 — Feeds Adafruit IO
// Adapter les noms selon les feeds créés sur io.adafruit.com
// Format : "username/feeds/nom-du-feed"
// -----------------------------------------------------------------------------
// Feeds pour les modules WiFi directs (Heltec_Direct_WiFi_Sensor) :
#define SECRET_FEED_TEMP     "votre_username_adafruit/feeds/local-temperature"
#define SECRET_FEED_HUM      "votre_username_adafruit/feeds/local-humidity"

// Feeds pour les receivers LoRa (LoRa_Receiver_HeltecV3, LoRa_Receiver_M5Core) :
#define SECRET_FEED_LORA_TEMP "votre_username_adafruit/feeds/LoRa_Temperature"
#define SECRET_FEED_LORA_HUM  "votre_username_adafruit/feeds/LoRa_Humidite"

// -----------------------------------------------------------------------------
// SECTION 4 — LoRaWAN OTAA (The Things Network / autre LNS)
// Utilisé par : LoRa_Sender_MKR-WAN-1310
// Obtenir les credentials : console.thethingsnetwork.org → Application → Device
// AppEUI  : identifiant de l'application (16 hex, format MSB)
// AppKey  : clé de chiffrement AES-128 (32 hex)
// -----------------------------------------------------------------------------
#define SECRET_LORAWAN_APP_EUI  "0000000000000000"
#define SECRET_LORAWAN_APP_KEY  "00000000000000000000000000000000"
